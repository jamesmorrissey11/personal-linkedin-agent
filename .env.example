# Copy to .env and fill in what you use. .env is git-ignored; never commit real values.
# The `linkedin-agent` command loads it at startup.

# Model backend: ollama (default), openai, azure, or fallback (Ollama first, then Azure OpenAI).
MODEL_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma3:latest

# OpenAI (MODEL_BACKEND=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Azure OpenAI (MODEL_BACKEND=azure or fallback). `azd provision` in deploy/azure writes these for you.
AZURE_TENANT_ID=
AZURE_OPENAI_SERVICE=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_CHAT_MODEL=

# Bounds on every LLM call
LLM_MAX_TOKENS=512
LLM_TIMEOUT_SECONDS=60

# Safety cap on invitations scanned per run
MAX_SCANNED_INVITATIONS=500

# LangGraph server behind Agent Inbox (`uv run linkedin-agent server`)
LANGGRAPH_URL=http://localhost:2024
# Only needed for a deployed (non-local) LangGraph server
LANGSMITH_API_KEY=

# Where runtime state lives (login session, LinkedIn lock, Agent Inbox data, logs).
# Default: ~/Library/Application Support/linkedin-agent on macOS, ~/.local/state/linkedin-agent elsewhere.
# LINKEDIN_AGENT_HOME=
